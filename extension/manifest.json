{
  "manifest_version": 3,
  "name": "SpeakSmart — AI English Coach",
  "version": "1.0.0",
  "description": "Instantly start an AI English conversation. Practice speaking, resume sessions, and toggle Tamil-Assisted mode — right from your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "SpeakSmart AI Coach"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "microphone",
    "storage",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:5000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
